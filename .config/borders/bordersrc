#!/bin/bash

options=(
    # Follow macOS/Tahoe rounded-window geometry.
    style=round

    # Strong enough to identify instantly on the Retina display.
    width=10
    hidpi=on

    # Better focus detection alongside a window manager.
    ax_focus=on

    # Vibrant cyan → magenta-purple.
    # active_color='glow(0xffff3df2)'
    active_color='glow(0xffff21e6)'
    # active_color='gradient(top_left=0xff22d3ee,bottom_right=0xffd946ef)'
    # active_color='gradient(top_left=0xff00f0ff,bottom_right=0xffff21e6)'

    # Very faint cool inactive outline.
    inactive_color=0x00000000

    # Stats is menu-bar/system-monitor UI; don't border it.
    blacklist="Stats"
)

borders "${options[@]}"
