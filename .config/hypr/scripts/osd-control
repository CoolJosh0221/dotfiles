#!/bin/sh
set -eu

action=${1:-}
if command -v swayosd-client >/dev/null 2>&1 && pgrep -u "$(id -u)" -x swayosd-server >/dev/null 2>&1; then
    case "$action" in
        volume-up) exec swayosd-client --output-volume +5 --max-volume 100 ;;
        volume-down) exec swayosd-client --output-volume -5 --max-volume 100 ;;
        volume-mute) exec swayosd-client --output-volume mute-toggle ;;
        mic-mute) exec swayosd-client --input-volume mute-toggle ;;
        next) exec swayosd-client --playerctl next ;;
        play-pause) exec swayosd-client --playerctl play-pause ;;
        previous) exec swayosd-client --playerctl prev ;;
        *) exit 2 ;;
    esac
fi

case "$action" in
    volume-up) exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    volume-down) exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    volume-mute) exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    mic-mute) exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    next) exec playerctl next ;;
    play-pause) exec playerctl play-pause ;;
    previous) exec playerctl previous ;;
    *) exit 2 ;;
esac
